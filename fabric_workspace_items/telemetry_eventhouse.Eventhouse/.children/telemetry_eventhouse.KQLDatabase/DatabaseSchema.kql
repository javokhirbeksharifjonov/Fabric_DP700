.create-merge table server_telemetry_logs (timestamp:datetime, service_name:string, endpoint:string, http_method:string, status_code:long, response_time_ms:long, bytes_sent:long, severity:string, region:string, user_agent:string, user_id:string, trace_id:string, error_message:string) 
