.create-merge table Weather (StartTime:datetime, EndTime:datetime, EpisodeId:long, EventId:long, State:string, EventType:string, InjuriesDirect:long, InjuriesIndirect:long, DeathsDirect:long, DeathsIndirect:long, DamageProperty:long, DamageCrops:long, Source:string, BeginLocation:string, EndLocation:string, BeginLat:real, BeginLon:real, EndLat:real, EndLon:real, EpisodeNarrative:string, EventNarrative:string, StormSummary:dynamic) 
.create-merge table test_events (StartTime:datetime, EndTime:datetime, EpisodeId:string, EventId:string, State:string, EventType:string, InjuriesDirect:long, InjuriesIndirect:long, DeathsDirect:long, DeathsIndirect:long, DamageProperty:long, DamageCrops:long, Source:string, BeginLocation:string, EndLocation:string, BeginLat:real, BeginLon:real, EndLat:real, EndLon:real, EpisodeNarrative:string, EventNarrative:string) 
.create-or-alter table test_events ingestion csv mapping 'test_events_mapping'
