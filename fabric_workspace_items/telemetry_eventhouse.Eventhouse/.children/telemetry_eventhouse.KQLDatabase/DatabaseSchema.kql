.create-merge table ServiceOwners (service_name:string, team:string) 
.create-merge table bike_events (BikepointID:string, Street:string, Neighbourhood:string, Latitude:real, Longitude:real, No_Bikes:int, No_Empty_Docks:int) 
.create-or-alter table bike_events ingestion json mapping 'bike_events_mapping'
